<Project>
  <!--
    The samples are file-based apps which build like an application outside of this repository: they use the installed
    ASP.NET Core shared framework instead of the repository build infrastructure, which is intentionally not imported.
    Each sample references the Output Caching project of this repository with a #:project directive.
  -->
  <PropertyGroup>
    <!-- Output Caching is also part of the shared framework, so NuGet can't prune the project reference. -->
    <NoWarn>$(NoWarn);NU1511</NoWarn>
  </PropertyGroup>
</Project>
